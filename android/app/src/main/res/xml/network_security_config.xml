<?xml version="1.0" encoding="utf-8"?>
<!-- Deny cleartext HTTP for all domains (Android 10+ / MobSF network policy). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
